{
  "name": "cs-knives-fliiper-front",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
	  "serve": "vite preview --port 5000",
	  "build-watch": "run-p type-check \"build-only-watch\"",
    "build-only-watch": "vite build --watch --emptyOutDir=false"
  },
  "dependencies": {
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  }
}
